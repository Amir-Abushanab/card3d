<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Remote design files (artwork, stickers, fonts) are downloaded by AssetCache. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Vulkan, else GLES 3.0. Not required, so the library doesn't filter an app's devices: without
       either, a stage reports a GPU error and draws nothing. -->
  <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400000" android:required="false" />
  <uses-feature android:glEsVersion="0x00030000" android:required="false" />

  <!-- CardStage.arIntent asks whether Scene Viewer is installed. -->
  <queries>
    <package android:name="com.google.ar.core" />
  </queries>

  <application>
    <!-- Hands exported AR files (CardStage.exportArFile) to a viewer: Scene Viewer, or any app. -->
    <provider
      android:name="com.card3d.CardFileProvider"
      android:authorities="${applicationId}.card3d.files"
      android:exported="false"
      android:grantUriPermissions="true" />
  </application>
</manifest>
