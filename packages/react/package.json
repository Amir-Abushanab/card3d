{
  "name": "@card3d/react",
  "version": "0.1.2",
  "description": "Drop-in 3D metal cards for React: the <MetalCard> component",
  "keywords": [
    "3d",
    "card",
    "component",
    "metal",
    "react",
    "webgl",
    "webgpu",
    "tanstack-intent"
  ],
  "homepage": "https://github.com/Amir-Abushanab/card3d/tree/main/packages/react#readme",
  "bugs": "https://github.com/Amir-Abushanab/card3d/issues",
  "license": "MIT",
  "author": "Amir Abushanab (https://github.com/Amir-Abushanab)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amir-Abushanab/card3d.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "skills/metal-card-react"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.tsx",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../scripts/package-notices.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@card3d/element": "workspace:^"
  },
  "devDependencies": {
    "@tanstack/intent": "0.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
